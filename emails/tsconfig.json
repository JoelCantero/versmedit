{
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "baseUrl": "..",
    "incremental": true,
    "tsBuildInfoFile": "./.next/cache/tsconfig.tsbuildinfo",
    "paths": {
      "@/*": [
        "./src/*"
      ]
    },
    "plugins": [
      {
        "name": "next"
      }
    ]
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    "../src/lib/email/presentation/**/*.ts",
    "../src/messages/*.json"
  ],
  "exclude": [
    "../node_modules"
  ]
}