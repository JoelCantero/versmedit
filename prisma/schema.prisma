// Prisma schema. Docs: https://pris.ly/d/prisma-schema
// Apply changes with migrations (constitution → Database Rules):
//   pnpm db:migrate   (dev)   /   pnpm db:deploy (prod)

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  // Prisma 7: the connection URL lives in prisma.config.ts (datasource.url), not here.
  provider = "postgresql"
}

enum UserStatus {
  PENDING
  ACTIVE
}

enum VerificationPurpose {
  LOGIN
  SIGNUP
  ACCOUNT_DELETION
}

// Auth.js (NextAuth) models — canonical Prisma adapter schema plus app timestamps.
// Add app-specific fields/relations here, then run `pnpm db:migrate`.
model User {
  id               String            @id @default(cuid())
  name             String?
  email            String            @unique
  normalizedEmail  String            @unique
  emailVerified    DateTime?
  image            String?
  status           UserStatus        @default(ACTIVE)
  accounts         Account[]
  sessions         Session[]
  policyAcceptance PolicyAcceptance?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id              String    @id @default(cuid())
  sessionToken    String    @unique
  userId          String
  expires         DateTime
  authenticatedAt DateTime?
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier     String
  token          String              @unique
  expires        DateTime
  purpose        VerificationPurpose @default(LOGIN)
  proposedName   String?
  locale         String?
  termsVersion   String?
  privacyVersion String?
  acceptedAt     DateTime?
  deliveredAt    DateTime?
  createdAt      DateTime            @default(now())

  @@unique([identifier, token])
  @@index([identifier, purpose, expires])
}

model PolicyAcceptance {
  id             String   @id @default(cuid())
  userId         String   @unique
  termsVersion   String
  privacyVersion String
  acceptedAt     DateTime
  createdAt      DateTime @default(now())
  user           User     @relation(fields: [userId], references: [id], onDelete: Restrict)
}

model RateLimitBucket {
  key       String   @id
  count     Int
  resetAt   DateTime
  updatedAt DateTime @updatedAt

  @@index([resetAt])
}
